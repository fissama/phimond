# Copy to .env. Use an entirely NEW database name; never an existing project schema.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=phimond
MYSQL_PASSWORD=
MYSQL_DATABASE=phimond_reconstruction
GAME_DB_NAME=phimond_reconstruction
MYSQL_TLS=false
# For hosted MySQL, prefer true and its service CA if required.
MYSQL_CA_FILE=
# Explicit development-only opt-in. Default false verifies server identity.
MYSQL_TLS_INSECURE=false
GAME_ADDR=127.0.0.1:8090
GAME_DATA_DIR=../../data
GAME_ALLOWED_ORIGINS=localhost:3100,127.0.0.1:3100
